          "message": "Reject duplicate object keys",
          "edits": [
            {
              "path": "src/parser.rs",
              "old_string": "            let key = self.parse_string()?;\n",
              "new_string": "            let key_pos = self.pos;\n            let key = self.parse_string()?;\n            if members.iter().any(|(existing, _)| *existing == key) {\n                return Err(ParseError::DuplicateKey { key, pos: key_pos });\n            }\n"
            }
          ]
        },
        "test": "repeated_member_is_rejected",
        "destination": "internal"
